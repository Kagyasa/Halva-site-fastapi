# =========================
# Application
# =========================

# development — локальная разработка
# production — боевой сервер
APP_ENV=development

# =========================
# PostgreSQL
# =========================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=halva
DB_USER=halva_user
DB_PASSWORD=change_me


# =========================
# Admin
# =========================

# Сгенерируйте длинную случайную строку для production.
ADMIN_SECRET_KEY=change_me_to_a_long_random_secret

# false — локальная разработка по HTTP
# true — обязательно в production с HTTPS
ADMIN_SESSION_HTTPS_ONLY=false


# =========================
# Email / SMTP
# =========================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=example@example.com
SMTP_PASSWORD=change_me

SMTP_USE_SSL=false
SMTP_STARTTLS=true

# Можно оставить пустым — тогда используется SMTP_USERNAME.
EMAIL_FROM=

# Адрес, на который приходят заявки.
ORDERS_EMAIL=orders@example.com