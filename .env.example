# Local development. Never commit a filled .env file.
APP_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=halva
DB_USER=halva_user
DB_PASSWORD=change_me
# Optional complete SQLAlchemy URL overrides DB_* settings.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/halva

# Generate with: python -m app.cli generate-secret
# Empty is allowed locally (sessions then expire on every restart).
ADMIN_SECRET_KEY=
ADMIN_SESSION_HTTPS_ONLY=false
ALLOWED_HOSTS=["localhost","127.0.0.1"]
DELIVERY_PRICE=150.00

# Configure these to send notifications; orders remain queued until a worker runs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
EMAIL_FROM=
ORDERS_EMAIL=
# true runs the durable email worker alongside the single Uvicorn process.
EMAIL_WORKER_ENABLED=false

# VPS Docker deployment only: domain without https:// or a path.
PUBLIC_DOMAIN=localhost
# Proxy addresses only. The VPS web port is bound to loopback, not the Internet.
FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12
